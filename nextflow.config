// ═══════════════════════════════════════════════════════════════════════════
// BioVarFlow — Configuration
// ═══════════════════════════════════════════════════════════════════════════

// Import Sarek's base config
includeConfig 'external/sarek/nextflow.config'
includeConfig 'conf/sarek_override.config'

// ═══════════════════════════════════════════════════════════════════════════
// PARAMETERS
// ═══════════════════════════════════════════════════════════════════════════

params {
  // Sarek configuration
  sarek_rev           = "3.7.1"
  sarek_profile       = "docker"
  genome              = "GATK.GRCh38"
  igenomes_ignore     = false
  // CNV calling is part of the standard germline run; see the cnvkit block below.
  tools               = "deepvariant,haplotypecaller,cnvkit,manta"
  skip_tools          = "baserecalibrator"
  save_mapped         = true
  save_output_as_bam  = true
  validate_params     = false

  // Run identifier propagated to the run-output manifest produced at the
  // very end of the pipeline. When null, it is resolved at runtime to
  // workflow.runName so the manifest is always emitted.
  run_id              = null

  // FASTQ preprocessing (mirrors schema)
  trim_fastq          = false
  clip_r1             = 0
  clip_r2             = 0
  three_prime_clip_r1 = 0
  three_prime_clip_r2 = 0
  trim_nextseq        = 0
  length_required     = 15
  save_trimmed        = false
  umi_read_structure  = null
  group_by_umi_strategy = "Adjacency"
  save_split_fastqs   = false

  // VEP / Annotation resources (GCS paths for BioNL)
  vep_cache           = "gs://vep-data-vaic/vep_data/cache"
  vep_fasta           = "gs://vep-data-vaic/vep_data/fasta/Homo_sapiens.GRCh38.dna.toplevel.fa"
  revel_vcf           = "gs://vep-data-vaic/vep_data/plugins/GRCh38/new_tabbed_revel_grch38.tsv.gz"
  alpha_missense_vcf  = "gs://vep-data-vaic/vep_data/plugins/GRCh38/AlphaMissense_hg38.tsv.gz"
  clinvar_vcf         = "gs://vep-data-vaic/vep_data/plugins/GRCh38/clinvar.chr.vcf.gz"
  spliceai_snv_vcf    = "gs://vep-data-vaic/vep_data/plugins/GRCh38/spliceai_scores.masked.snv.hg38.vcf.gz"
  spliceai_indel_vcf  = "gs://vep-data-vaic/vep_data/plugins/GRCh38/spliceai_scores.masked.indel.hg38.vcf.gz"
  bayesdel_vcf        = "gs://vep-data-vaic/vep_data/plugins/GRCh38/BayesDel_addAF_GRCh38_complete.txt.gz"
  vep_plugins         = "gs://vep-data-vaic/vep_plugins"

  // Exomiser: phenotype-driven ranking over the whole callset (off-panel too).
  // On by default; needs --phenotypes and --create_consensus.
  run_exomiser        = true
  exomiser_data_gs    = "gs://vep-data-vaic/exomiser"   // holds <ver>_hg38 and <ver>_phenotype
  exomiser_data_dir   = "/scratch/exomiser-data"        // task-local target for the rsync
  exomiser_version    = "2512"
  // Built from containers/exomiser/Dockerfile. The upstream
  // exomiser/exomiser-cli image is distroless -- no shell, so Nextflow cannot
  // run any script block in it -- and has no gcloud for the data sync.
  exomiser_container  = "docker.io/alkhatib93/exomiser-cli:15.1.0"
  phenotypes          = null                            // CSV: sample,sex,hpo

  // Somatic variant calling mode (Mutect2 instead of DeepVariant/HaplotypeCaller)
  somatic_mode        = false

  // ───────────────────────────────────────────────────────────────────────
  // CNV calling (CNVkit)
  //
  // On when 'cnvkit' is in --tools. Sarek computes the coverage; the
  // post-processing in modules/cnv.nf does the rest. See docs/cnv.md.
  //
  // Building panels of normals is out of scope: the customer, or a separate
  // PoN pipeline, delivers a ready CNVkit reference .cnn, and it must come
  // from the same BED as cnv_targets_bed. The run stops early if it does not.
  // ───────────────────────────────────────────────────────────────────────

  // The ONLY CNV input that comes from the user: the panel of normals built
  // from this project's own normals. Everything else is fixed here.
  cnv_pon               = null

  // Capture kit target BED (4 cols). NOT passed to sarek: with a PoN, CNVkit
  // derives its bins from the .cnn and sarek's cnvkit module suppresses
  // --targets entirely (modules/nf-core/cnvkit/batch/main.nf). This param is
  // the record of which BED the PoN must have been built from, and the BED to
  // build a new PoN against. This is IDT xGen Exome v2, hg38.
  cnv_targets_bed       = "${projectDir}/data/xgen_v2_targets.hg38.cnvkit.bed"

  // Exon BED of the reportable genes a CNV must hit to reach Tier 1. The same
  // panel the SNV side uses, not the capture kit above.
  cnv_panel_bed         = "${projectDir}/data/ACMG_SF_plus_HemOnc_MANE_exons_50bp.refseq.bed"
  cnv_panel_name        = "ACMG SF + HemOnc"

  // Cohort-recurrent CNV regions: the common_cnv.bed built alongside the PoN by
  // the cnv_normal pipeline. Part of the PoN delivery, supplied by the user with
  // cnv_pon -- a BED from a different PoN is worse than none. Columns: chrom,
  // start, end, type (DEL/DUP/DEL+DUP/HOMDEL), n_samples=N.
  //
  // Not optional in practice. Filtering XZJR against pon.A without it moved
  // Tier 1 from 0 to 2 and Tier 2 from 7 to 24, all cohort-recurrent artifacts.
  // The HOMDEL rows matter most in single-sample runs, where the in-run
  // recurrence test (>= 3 samples homozygous) cannot fire at all.
  cnv_common_bed        = null

  // true only if the PoN was built with `cnvkit reference -y`. Getting this
  // wrong makes a normal male chrX read as cn = 0, so it is never guessed.
  cnv_pon_haploid_x     = false
  cnv_pon_size          = null   // normals in the PoN; below cnv_min_pon_size calls are flagged

  // Genome-build resources, shared by every hg38 project. See docs/cnv.md for
  // how the slim gnomAD SV table is prepared.
  cnv_gnomad_sv         = "gs://vep-data-vaic/cnv/gnomad_v4.1_sv_DEL_DUP_CNV.tsv"
  cnv_gnomad_exome_cnv  = "gs://vep-data-vaic/cnv/gnomad.v4.1.cnv.all.vcf.gz"
  cnv_clingen           = "gs://vep-data-vaic/cnv/ClinGen_gene_curation_list_GRCh38.tsv"
  cnv_segdup            = "gs://vep-data-vaic/cnv/genomicSuperDups.txt.gz"

  // Thresholds. Defaults are the ones validated in docs/cnv_validation.md;
  // change them per project rather than editing the filter.
  cnv_segment_threshold = 0.001  // cnvkit segment -t; sensitive CBS
  cnv_chrx_tolerance    = 0.35   // chrX median log2 may drift this far from expectation
  cnv_max_bivar         = 0.25   // level 1: sample noise ceiling
  cnv_min_pon_size      = 10     // level 1: below this, "low confidence" flag
  cnv_min_exons         = 3      // level 2: exons in a call
  cnv_del_log2          = -0.4   // level 2: germline deletion signal
  cnv_dup_log2          = 0.3    // level 2: germline duplication signal
  cnv_mosaic_exons      = 50     // level 2: mosaic route, min exons
  cnv_mosaic_log2       = 0.2    // level 2: mosaic route, min |delta log2|
  cnv_min_depth         = 20     // level 2: segment depth
  cnv_max_spread        = 0.3    // level 2: median PoN spread over the call
  cnv_max_af            = 0.01   // level 3: gnomAD-SV frequency ceiling
  cnv_recip_overlap     = 0.5    // level 3: reciprocal overlap for a frequency match
  cnv_small_exons       = 5      // calls this small are flagged for MLPA/ddPCR

  // Homozygous deletions. `segment --drop-low-coverage` removes 0-read bins
  // before segmentation, so a 2-copy loss never reaches a segment at all --
  // CFHR3/CFHR1 (log2 ~ -27) was missed in all 7 KHCC samples that carry it,
  // 0 of 22 of 3billion's calls. CNV_FILTER therefore scans the .cnr directly.
  cnv_homdel_log2        = -3    // bin log2 vs expected below this is ~0 copies
  cnv_homdel_min_bins    = 2     // consecutive target bins required
  cnv_homdel_cohort_frac = 0.5   // other samples that must have normal coverage there
  cnv_homdel_min_cohort  = 5     // below this many other samples, trust the PoN alone

  // BAM samplesheet for starting from already-mapped data.
  // When provided, --input_bam is used as the samplesheet and Sarek
  // starts from the markduplicates step instead of alignment.
  // Required columns: patient, sex, status, sample, bam, bai
  input_bam           = null

  // Script directory used by MANIFEST module (overrideable).
  scriptdir           = "${projectDir}/scripts"
}

// When starting from BAM files, auto-set Sarek's input and step.
if (params.input_bam) {
    params.input = params.input_bam
    params.step  = 'markduplicates'
}

// Override tools for somatic mode.
if (params.somatic_mode) {
    params.tools = "mutect2"
}

// ───────────────────────────────────────────────────────────────────────────
// Exome wiring for CNVkit and Manta: params.wes, and deliberately NOT
// params.intervals.
//
// params.wes is the one that matters. It is what sarek turns into CNVkit's
// --method hybrid (conf/modules/cnvkit.config) and Manta's --exome
// (conf/modules/manta.config). Without it CNVkit bins exome data as WGS at
// 20 kb: noise around bivar 1.0 and false whole-chromosome calls.
//
// params.intervals is left unset on purpose. Sarek has no per-tool intervals
// and no interval padding at all, so setting it restricts EVERY caller to the
// BED verbatim. Measured against the panel: the capture probes stop at the
// coding exon edge, so the intronic half of ~90% of exon-boundary windows
// falls outside them and the canonical +1/+2/-1/-2 splice positions would
// never be called by DeepVariant or HaplotypeCaller.
//
// CNVkit does not need intervals: when --cnvkit_reference is given,
// reference_exists is true and the module drops --targets, taking its bins
// from the PoN instead. Manta loses --callRegions and scans genome-wide,
// which is slower and noisier off-target but not wrong.
//
// The cost of leaving it unset: PREPARE_INTERVALS falls back to building
// whole-chromosome intervals from the .fai, so sarek's mosdepth reports
// genome-wide coverage rather than on-target coverage -- there is no
// "% of targets at >=20x" number any more. The panel-level QC in this
// pipeline's own QC gate uses params.bed and is unaffected.
// ───────────────────────────────────────────────────────────────────────────
if (params.tools && params.tools.split(',').collect { it.trim() }.any { it in ['cnvkit', 'manta'] }) {
    params.wes = true
}

// CNVkit additionally needs a panel of normals. --cnvkit_reference stops sarek
// building its own flat reference from the fasta.
if (params.tools && params.tools.split(',').contains('cnvkit')) {
    if (params.cnv_pon) {
        params.cnvkit_reference = params.cnv_pon

        // A PoN delivery is the .cnn AND the common_cnv.bed built with it. The
        // run still works without the BED, but the cohort-recurrent artifacts
        // it exists to catch land in Tier 1 and Tier 2, which is where a
        // reporting scientist looks first. Warn loudly rather than stop: a
        // third-party or older PoN may genuinely not have one.
        if (!params.cnv_common_bed) {
            System.err.println(
                "\nWARNING: --cnv_pon given without --cnv_common_bed.\n" +
                "         Cohort-recurrent CNV artifacts will NOT be recognised and will\n" +
                "         reach Tier 1 and Tier 2. On the KHCC cohort this moved one sample\n" +
                "         from 0 to 2 Tier 1 calls and from 7 to 24 Tier 2 calls, all of\n" +
                "         them recurrent artifacts.\n" +
                "         Supply the common_cnv.bed built alongside this PoN.\n")
        }
    }
    else {
        // CNV calling is on by default, but it cannot run without a panel of
        // normals and this pipeline does not build one. Dropping cnvkit keeps a
        // germline run working for projects that have no PoN yet, rather than
        // failing every run that did not upload one. Manta is unaffected and
        // still runs. The warning is deliberately loud: a silently skipped CNV
        // section is the worse failure.
        params.tools = params.tools.split(',').findAll { it.trim() != 'cnvkit' }.join(',')
        System.err.println(
            "\nWARNING: no --cnv_pon given, so CNV calling is SKIPPED for this run.\n" +
            "         CNVkit needs a panel of normals built from this project's own\n" +
            "         normals, from the same BED as cnv_targets_bed. Supply it with\n" +
            "         --cnv_pon <reference.cnn> to get the CNV report.\n" +
            "         Manta still runs and still reports structural variants.\n" +
            "         Tools for this run: " + params.tools + "\n")
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// PROCESS DEFAULTS
// ═══════════════════════════════════════════════════════════════════════════

process {
  cpus   = 8
  memory = '4 GB'
  time   = '12h'

  // params.intervals is unset (see the exome wiring block above), so
  // PREPARE_INTERVALS hands mosdepth whole-chromosome intervals. Sarek turns
  // off --fast-mode whenever params.wes is true, which would make mosdepth
  // compute per-base depth across the whole genome and emit a per-base BED of
  // that size. The on-target metric is already gone, so run the genome-wide
  // QC in genome-wide mode.
  withName: 'MOSDEPTH' {
    ext.args = "-n --fast-mode --by 500"
  }

  errorStrategy = 'terminate'
  maxRetries    = 4

  // Do not set a global publishDir here — it would override Sarek's internal
  // publishDir directives and misplace variant_calling/ outputs.
  // Each BioVarFlow process declares its own publishDir explicitly.
  publishDir = [
    path    : { "results/${task.process.tokenize(':')[-1].toLowerCase()}" },
    mode    : 'copy',
    enabled : true
  ]
}

// ═══════════════════════════════════════════════════════════════════════════
// EXECUTOR
// ═══════════════════════════════════════════════════════════════════════════

executor {
  name      = 'local'
  queueSize = 100
}

// ═══════════════════════════════════════════════════════════════════════════
// PROFILES (Easy switching between local/BioNL)
// ═══════════════════════════════════════════════════════════════════════════

profiles {
  // Local execution with Conda
  local {
    conda.enabled  = true
    docker.enabled = false
  }

  // BioNL/Standard execution with Docker containers (DEFAULT)
  standard {
    docker.enabled = true
    conda.enabled  = false
    
    process {
      
      // Default container for bcftools processes
      container = 'quay.io/biocontainers/bcftools:1.20--h8b25389_0'
      
      withName: 'VEP_Annotate|VEP_Annotate_DB' {
        container = 'quay.io/biocontainers/ensembl-vep:115.2--pl5321h2a3209d_1'
        memory    = '16 GB'
        cpus      = 8
      }
      
      withName: 'MosdepthRun' {
        container = 'quay.io/biocontainers/mosdepth:0.3.11--h0ec343a_1'
      }
      
      withName: 'LeanReport|GENERATE_ACMG_REPORT|MergeVariantsTable' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
        memory    = '8 GB'
      }
      

      withName: 'StrandBiasTest' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
        cpus      = 1
        memory    = '2 GB'
      }

      withName: 'EXOMISER_BATCH' {
        container = 'docker.io/alkhatib93/exomiser-cli:15.1.0'
        cpus      = 4
        memory    = '16 GB'
        disk      = '150 GB'
      }
      withName: 'CoverageGapsAnnotation|CoverageSummary' {
        container = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_2'
      }
      
      withName: 'BedFilterBAM|R1R2Ratio|ForwardReverseRatio|SamtoolsFlagstat|SamtoolsStats|SexCheck' {
        container = 'quay.io/biocontainers/samtools:1.20--h50ea8bc_0'
      }

      // CNVkit post-processing. Pinned to 0.9.13, the version the method was
      // validated on; sarek ships 0.9.10, whose `segment` lacks --smooth-cbs
      // behaviour we depend on. The filter needs openpyxl for the workbook,
      // which the cnvkit container lacks, so it runs in the python image.
      withName: 'CNVKIT_POSTPROCESS' {
        container = 'quay.io/biocontainers/cnvkit:0.9.13--pyhdfd78af_0'
        cpus      = 4
        memory    = '16 GB'
      }

      withName: 'CNV_FILTER|CNV_QC_SUMMARY' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
        cpus      = 2
        memory    = '8 GB'
      }

      // DB QC Export (only JSON aggregation needs a container; vcfstats uses default bcftools)
      withName: 'DB_QC_EXPORT_JSON' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
      }

      // Run-output manifest (Python; reuses the bionl python container)
      withName: 'CREATE_OUTPUT_MANIFEST' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
        cpus      = 1
        memory    = '2 GB'
      }
    }
    
    google {
      project  = 'your-gcp-project-id'  // Update this
      region   = 'europe-west4'
      
      lifeSciences {
        preemptible = true
        bootDiskSize = 20.GB
      }
    }
  }

  // Alias for standard (BioNL) - just uses same config as standard
  bionl {
    docker.enabled = true
    conda.enabled  = false
    
    process {
      
      // Default container for bcftools processes
      container = 'quay.io/biocontainers/bcftools:1.20--h8b25389_0'
      
      withName: 'VEP_Annotate|VEP_Annotate_DB' {
        container = 'quay.io/biocontainers/ensembl-vep:115.2--pl5321h2a3209d_1'
        memory    = '16 GB'
        cpus      = 4
      }
      
      withName: 'MosdepthRun' {
        container = 'quay.io/biocontainers/mosdepth:0.3.11--h0ec343a_1'
      }

      withName: 'MUTECT2_RESCUE' {
        container = 'quay.io/biocontainers/htslib:1.20--h5efdd21_2'
        cpus      = 2
        memory    = '4 GB'
      }

      withName: 'LeanReport|GENERATE_ACMG_REPORT|MergeVariantsTable' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
        memory    = '8 GB'
      }


      withName: 'StrandBiasTest' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
        cpus      = 1
        memory    = '2 GB'
      }

      withName: 'EXOMISER_BATCH' {
        container = params.exomiser_container
        cpus      = 4
        memory    = '16 GB'
        disk      = '150 GB'
      }
      withName: 'CoverageGapsAnnotation|CoverageSummary' {
        container = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_2'
      }

      withName: 'BedFilterBAM|R1R2Ratio|ForwardReverseRatio|SamtoolsFlagstat|SamtoolsStats|SexCheck' {
        container = 'quay.io/biocontainers/samtools:1.20--h50ea8bc_0'
      }

      // CNVkit post-processing. Pinned to 0.9.13, the version the method was
      // validated on; sarek ships 0.9.10, whose `segment` lacks --smooth-cbs
      // behaviour we depend on. The filter needs openpyxl for the workbook,
      // which the cnvkit container lacks, so it runs in the python image.
      withName: 'CNVKIT_POSTPROCESS' {
        container = 'quay.io/biocontainers/cnvkit:0.9.13--pyhdfd78af_0'
        cpus      = 4
        memory    = '16 GB'
      }

      withName: 'CNV_FILTER|CNV_QC_SUMMARY' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
        cpus      = 2
        memory    = '8 GB'
      }

      // DB QC Export (only JSON aggregation needs a container; vcfstats uses default bcftools)
      withName: 'DB_QC_EXPORT_JSON' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
      }

      // Run-output manifest (Python; reuses the bionl python container)
      withName: 'CREATE_OUTPUT_MANIFEST' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
        cpus      = 1
        memory    = '2 GB'
      }
    }
  }

  // Test profile with minimal data
  test {
    params {
      input  = 'data/samplesheet.csv'
      outdir = 'test_results'
      max_cpus   = 2
      max_memory = '6 GB'
      max_time   = '2h'
    }
  }

  // Development profile (faster, less strict)
  dev {
    process.errorStrategy = 'ignore'
    process.maxRetries    = 1
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// RESOURCE LABELS
// ═══════════════════════════════════════════════════════════════════════════

process {
  withLabel: process_low {
    cpus   = 2
    memory = '4 GB'
    time   = '4h'
  }
  
  withLabel: process_medium {
    cpus   = 8
    memory = '16 GB'
    time   = '12h'
  }
  
  withLabel: process_high {
    cpus   = 16
    memory = '32 GB'
    time   = '24h'
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// PLUGINS
// ═══════════════════════════════════════════════════════════════════════════

plugins {
  id 'nf-schema@2.4.0'
}

// ═══════════════════════════════════════════════════════════════════════════
// REPORTING
// ═══════════════════════════════════════════════════════════════════════════

report {
  enabled   = true
  file      = '${params.outdir}/pipeline_info/pipeline_report.html'
  overwrite = true
}

timeline {
  enabled   = true
  file      = '${params.outdir}/pipeline_info/timeline_report.html'
  overwrite = true
}

trace {
  enabled   = true
  file      = '${params.outdir}/pipeline_info/trace.txt'
  overwrite = true
  fields    = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

dag {
  enabled   = true
  file      = '${params.outdir}/pipeline_info/pipeline_dag.html'
  overwrite = true
}

// ═══════════════════════════════════════════════════════════════════════════
// MANIFEST
// ═══════════════════════════════════════════════════════════════════════════

manifest {
  name            = 'BioVarFlow'
  author          = 'Bionl'
  homePage        = 'https://github.com/bionl/BioVarFlow'
  description     = 'End-to-end pipeline: germline variant calling (Bionl_Lean_Call) → QC filtering → DB ingestion (bionl_lean_db_export) for READY samples'
  mainScript      = 'main.nf'
  nextflowVersion = '!>=23.04.0'
  version         = '1.0.0'
  doi             = ''
}